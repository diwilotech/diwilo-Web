{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Proyecto Cloudflare Pages "diwilo": se despliega solo en cada push a main.
  // public/     sitio estático (incluye el panel en /admin)
  // functions/  rutas dinámicas: /api, /admin/api, /l, /c, /v1
  "name": "diwilo",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "diwilo-admin-db", "database_id": "076cb7c8-d60b-4cff-918f-2de045696be8" }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "ALLOWED_ORIGINS": "https://diwilo.com,https://www.diwilo.com,https://diwilo.pages.dev"
  }
  // Secretos (no van en este archivo):
  //   npx wrangler pages secret put ADMIN_PASSWORD --project-name diwilo
  //   npx wrangler pages secret put GEMINI_API_KEY --project-name diwilo   (opcional)
}
